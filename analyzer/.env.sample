# ==========================================
# Ares (ABBH) Analyzer Environment Variables
# ==========================================

# DeepSeek — LLM RAG vulnerability reasoning agent
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_MODEL="deepseek-v4-pro"                  # primary model (set to deepseek-v4-flash for a cheaper verified-source tier)
DEEPSEEK_DECOMPILE_MODEL="deepseek-v4-pro"        # model for DECOMPILED (unverified) — flash can't do it
DEEPSEEK_BASE_URL="https://api.deepseek.com"      # override for a proxy/gateway

# Access control — only callers sending this as the x-ares-key header may hit the
# expensive endpoints. MUST match ANALYZER_API_KEY on the server. openssl rand -hex 32
# If left unset the analyzer runs UNPROTECTED (anyone with the URL can call it).
ANALYZER_API_KEY="change-me-to-a-long-random-string"

GITHUB_TOKEN="your-github-token-here"