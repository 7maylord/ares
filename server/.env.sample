# ==========================================
# Ares (ABBH) Server Environment Variables
# ==========================================

# Port for the NestJS gateway API
PORT=3001

# 1. Database Configuration (Supabase / Postgres)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Blockchain Configuration
# RPC endpoint for Mantle Sepolia (e.g. Mantle public RPC or Alchemy)
MANTLE_SEPOLIA_RPC_URL="https://rpc.sepolia.mantle.xyz"

# API key for Mantlescan (https://mantlescan.xyz) — used to fetch verified source code
MANTLESCAN_API_KEY="your-mantlescan-api-key"

# The deployed address of the BountyPool.sol contract on Mantle Sepolia
POOL_ADDRESS="0x9Bc25B223787Ce045e8B5C19A2547B3b1eBDA1D8"

# The deployed address of the BountyEscrow.sol contract on Mantle Sepolia
ESCROW_ADDRESS="0x084D072416984F89d9dfF6548A357C88aE7A39Fe"

# The deployed address of the ReputationLedger.sol contract on Mantle Sepolia
REPUTATION_ADDRESS="0x2986F9236991F156aEfB94F369551a95E67F0aCc"

# The private key of the Agent wallet that will submit findings (do NOT use your main wallet!)
AGENT_PRIVATE_KEY="0xYourAgentPrivateKeyHere"

# 3. Microservice Config
# URL where the Python Analyzer API is running
ANALYZER_SERVICE_URL="http://localhost:8000"

# 4. Paid Audit Endpoint
# Address that receives MNT payment for POST /audit
# Callers must send >= 2 MNT to this address on Mantle Sepolia and pass the txHash
PAYMENT_ADDRESS="0x2986F9236991F156aEfB94F369551a95E67F0aCc"

# FUTURE: Queue Configuration (Redis — required for BullMQ)
# Uncomment when re-enabling the Redis job queue (see server/src/queue/queue.module.ts)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
