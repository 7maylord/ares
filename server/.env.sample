# ==========================================
# Ares (ABBH) Server Environment Variables
# ==========================================

# Port for the NestJS gateway API
PORT=3001

# 1. Database Configuration (Supabase / Postgres)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Blockchain Configuration
# RPC endpoint for Mantle Sepolia (e.g. Mantle public RPC or Alchemy)
MANTLE_SEPOLIA_RPC_URL="https://rpc.sepolia.mantle.xyz"

# API key for Mantlescan (https://mantlescan.xyz) — used to fetch verified source code
MANTLESCAN_API_KEY="your-mantlescan-api-key"

# The deployed address of the BountyPool.sol contract on Mantle Testnet
POOL_ADDRESS="0xYourBountyPoolAddressHere"

# The deployed address of the BountyEscrow.sol contract on Mantle Testnet
ESCROW_ADDRESS="0xYourBountyEscrowAddressHere"

# The private key of the Agent wallet that will submit findings (do NOT use your main wallet!)
AGENT_PRIVATE_KEY="0xYourAgentPrivateKeyHere"

# 3. Queue Configuration (Redis — required for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# 4. Microservice Config
# URL where the Python Analyzer API is running
ANALYZER_SERVICE_URL="http://localhost:8000"

# 4. LLM / RAG Configuration
# Anthropic API key for the LLM reasoner (used by the Python analyzer)
ANTHROPIC_API_KEY="sk-ant-..."

