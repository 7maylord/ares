# Root .env — used by docker-compose.
# Copy to .env and fill in real values before running `docker compose up`.

# ── DeepSeek (shared by server and analyzer) ──────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash            # or deepseek-v4-pro

# ── Analyzer access control ─────────────────────────────────────────────────
# Shared secret; the SAME value must be set on both the server and the analyzer.
# Generate: openssl rand -hex 32
ANALYZER_API_KEY=change-me-to-a-long-random-string

# ── Database (Supabase / Postgres) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Blockchain ──────────────────────────────────────────────────────────────
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLESCAN_API_KEY=your-mantlescan-api-key

# Deployed contract addresses (Mantle Sepolia)
POOL_ADDRESS=0x9Bc25B223787Ce045e8B5C19A2547B3b1eBDA1D8
ESCROW_ADDRESS=0x084D072416984F89d9dfF6548A357C88aE7A39Fe

# Agent wallet — use a dedicated wallet, never your main one
AGENT_PRIVATE_KEY=0xYourAgentPrivateKeyHere

# FUTURE: Queue (Redis / BullMQ) — uncomment when re-enabling the job queue
# REDIS_HOST=localhost
# REDIS_PORT=6379
